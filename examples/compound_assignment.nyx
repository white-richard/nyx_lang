// Compound assignment operators.
int main() {
    int x = 10;
    x += 5;
    printf("x += 5  -> %d\n", x);
    x -= 3;
    printf("x -= 3  -> %d\n", x);
    x *= 4;
    printf("x *= 4  -> %d\n", x);
    x /= 6;
    printf("x /= 6  -> %d\n", x);
    x %= 5;
    printf("x %%= 5  -> %d\n", x);
    return 0;
}
