// if / else if / else.
int classify(int n) {
    if (n < 0) {
        printf("%d is negative\n", n);
    } else if (n == 0) {
        printf("%d is zero\n", n);
    } else {
        printf("%d is positive\n", n);
    }
    return 0;
}

int main() {
    classify(-4);
    classify(0);
    classify(9);
    return 0;
}
