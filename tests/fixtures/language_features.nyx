    int c;
};

unsigned long long factorial(int n) { 
    if (n < 0) { 
        printf("Error: Factorial of a negative number doesn't exist.\n");
        return 0;
    } 
    unsigned long long result = 1;
    for (int i = 1; i <= n; ++i) {
        result *= i;
    } 
    return result;
}

float ret_float() {
    return 3.14;
}

